# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Admin login mapping (optional — username resolves to email at sign-in)
VITE_ADMIN_EMAIL=
VITE_ADMIN_USERNAME=

# Login rate limiting (optional server overrides)
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
